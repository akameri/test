# --- Datenbank -------------------------------------------------------------
DATABASE_URL=postgresql://nis2:nis2secret@localhost:5432/nis2grc?schema=public

# --- API -------------------------------------------------------------------
API_PORT=4000
# Erlaubte Origin für das Web-Frontend (CORS)
WEB_ORIGIN=http://localhost:3000

# --- Authentifizierung -----------------------------------------------------
# demo  : kein Login nötig (lokale Entwicklung / Produkt-Demo)
# oidc  : Token-Validierung gegen Keycloak (Produktion)
AUTH_MODE=demo
# Nur für AUTH_MODE=oidc:
KEYCLOAK_ISSUER=http://localhost:8080/realms/nis2
KEYCLOAK_AUDIENCE=nis2-api

# --- Web-Frontend ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
# Nur für AUTH_MODE=oidc (next-auth):
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=please-change-me
KEYCLOAK_CLIENT_ID=nis2-web
KEYCLOAK_CLIENT_SECRET=please-change-me
