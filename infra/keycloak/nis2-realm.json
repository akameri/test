{
  "realm": "nis2",
  "enabled": true,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Vollzugriff inkl. Konfiguration" },
      { "name": "ciso", "description": "Maßnahmen und Risiken pflegen" },
      { "name": "auditor", "description": "Nur-Lese-Zugriff und Berichte" }
    ]
  },
  "clients": [
    {
      "clientId": "nis2-web",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "please-change-me",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "nis2-api",
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "ciso",
      "enabled": true,
      "email": "ciso@example.com",
      "firstName": "Clara",
      "lastName": "Sicher",
      "credentials": [{ "type": "password", "value": "ciso", "temporary": true }],
      "realmRoles": ["ciso"]
    },
    {
      "username": "auditor",
      "enabled": true,
      "email": "auditor@example.com",
      "firstName": "Alex",
      "lastName": "Prüfer",
      "credentials": [{ "type": "password", "value": "auditor", "temporary": true }],
      "realmRoles": ["auditor"]
    }
  ]
}
